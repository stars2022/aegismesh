# Runtime
DATABASE_URL=sqlite:///./backend/data/aegismesh.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_KEY=

# Management console authentication is fail-closed. Run scripts/setup-admin.sh before use.
ADMIN_AUTH_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false
PROVIDER_ENCRYPTION_KEY=
# JSON map of approved environment-secret names to their exact HTTPS origins.
PROVIDER_SECRET_ENV_BINDINGS={}

# Required by scripts/deploy.sh for public deployment
TLS_CERT_FILE=
TLS_KEY_FILE=

# Optional OpenAI-compatible model (DeepSeek / Qwen / Doubao / others)
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_ENABLED=false

# OpenAI Responses API
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic Messages API
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=60

# AIP identity issued through trusted registration
LEADER_AIC=
AIP_POLL_INTERVAL_SECONDS=0.8
AIP_IDENTITY_BINDING_ENABLED=false
AIP_CA_FILE=
AIP_CERT_FILE=
AIP_KEY_FILE=
AIP_TLS_CERTFILE=
AIP_TLS_KEYFILE=
AIP_TLS_CLIENT_CA_FILE=
AIP_TLS_PORT=0
AIP_NOTIFICATION_ALLOWED_ORIGINS=

# Public URL used in the ACS submitted to the trusted registry
PUBLIC_BASE_URL=

# Trusted registry and certificate authority
REGISTRY_API_URL=https://wt.ioa.pub/registry-server/api/v1
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_TIMEOUT_SECONDS=15
CA_SERVER_URL=
CA_ACCOUNT_KEY_FILE=
CERTS_DIR=data/certs

# ADP discovery server, for example https://discovery.example.com
ADP_DISCOVERY_URL=
ADP_TIMEOUT_SECONDS=10
PROBE_INTERVAL_SECONDS=30

# ---- AIP 国标群组模式（可选；不配置时集群研讨走本地黑板）----
# RabbitMQ 连接（二选一）
AIP_GROUP_MQ_URL=amqp://guest:guest@localhost:5672/%2F
# AIP_GROUP_MQ_HOST=localhost
# AIP_GROUP_MQ_PORT=5672
# AIP_GROUP_MQ_VHOST=/
# AIP_GROUP_MQ_USER=guest
# AIP_GROUP_MQ_PASSWORD=guest
AIP_GROUP_DISCUSSION_TIMEOUT_SECONDS=120
# 让本平台智能体作为 Partner 接受外部群组邀请（需 MQ 配置）
AIP_GROUP_PARTNER_ENABLED=false
AIP_GROUP_PARTNER_AGENT_ID=
