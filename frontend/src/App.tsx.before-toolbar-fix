                  : "执行异常"}
            </span>
            {collab.phase_name && (
              <span className="collab-phase-pill">{collab.phase_name}</span>
            )}
            {collab.tokens_per_second != null && (
              <span className="collab-speed-pill">
                {collab.tokens_per_second} tok/s{collab.tokens_per_second_approximate ? " (约)" : ""}
              </span>
            )}
            {collab.eta_seconds != null && (
              <span className="collab-eta-pill">
                预估剩余 {collab.eta_seconds}s
              </span>
            )}
            {collab.elapsed_seconds != null && (
              <span className="collab-elapsed-pill">
                耗时 {collab.elapsed_seconds}s
              </span>
            )}
            {collab.latency_ms != null && (
              <span className="collab-latency">{formatMs(collab.latency_ms)}</span>
            )}
          </div>
        </div>
      </div>

      <div className="subagent-dialogue-messages">
        {/* 协调器下发指令 */}
        <div className="subagent-msg-bubble user-task">
          <div className="subagent-msg-role">
            <span>协调主智能体 · 任务派发</span>
          </div>
          <div className="subagent-task-content">
            <p>{collab.task}</p>
          </div>
        </div>

        {/* 工具调用轨迹 */}
        {collab.tools && collab.tools.length > 0 && (
          <div className="subagent-tools-trajectory">
            <div className="subagent-tools-heading">
              <Sparkles size={12} />
              <span>工具调用轨迹 ({collab.tools.length})</span>
            </div>
            <div className="collab-tools-list">
              {collab.tools.map((tool, idx) => (
                <div className="collab-tool-item" key={idx}>
                  <div className="collab-tool-head">
                    <span className="tool-chip">
                      {toolNames[tool.name] || tool.name}
                    </span>
                    <code>{tool.name}</code>
                  </div>
                  {tool.arguments && Object.keys(tool.arguments).length > 0 && (
                    <pre className="collab-tool-args">
                      {JSON.stringify(tool.arguments, null, 2)}
                    </pre>
                  )}
                  {tool.output_preview && (
                    <div className="collab-tool-preview">
                      <span>输出摘要：</span>
                      <p>{tool.output_preview}</p>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* 子智能体回答 / 回传 */}
        <div className="subagent-msg-bubble assistant-response">
          <div className="subagent-msg-role">
            <div className="subagent-role-avatar">
              <Bot size={13} />
            </div>
            <span>{collab.agent_name}</span>
            {collab.result && (
              <button
                type="button"
                className="subagent-copy-btn"
                onClick={handleCopy}
                title="复制此回答"
              >
                {copied ? <Check size={12} /> : <Copy size={12} />}
                <span>{copied ? "已复制" : "复制"}</span>
              </button>
            )}
          </div>

          {collab.status === "running" ? (
            <div className="subagent-running-state">
              <span className="pulse" />
              <span>子智能体正在协同执行中，回传后将在此实时展示...</span>
            </div>
          ) : collab.result ? (
            <div className="subagent-response-markdown">
              <MarkdownText text={collab.result} />
            </div>
          ) : collab.error ? (
            <div className="collab-error-box">
              <p>{collab.error}</p>
            </div>
          ) : (
            <div className="inspector-empty">未产生回答内容</div>
          )}
        </div>
      </div>

      <div className="subagent-readonly-bar">
        <Lock size={12} className="lock-icon" />
        <span>协同智能体对话为只读视图，由主智能体调度管理，不可直接发言</span>
      </div>
    </div>
  );
}

function CollaborationPanel({
  inspector,
  liveSubagents = [],
  toolNames = {},
}: {
  inspector: ChatResult | null;
  liveSubagents?: LiveSubagentState[];
  toolNames?: Record<string, string>;
}) {
  const [selectedKey, setSelectedKey] = useState<string | null>(null);
  const [selectedCollabSnapshot, setSelectedCollabSnapshot] =
    useState<SubagentCollaboration | null>(null);
  const [viewMode, setViewMode] = useState<"detail" | "conversation">("detail");
  const [copied, setCopied] = useState(false);

  useEffect(() => {
    setSelectedKey(null);
    setSelectedCollabSnapshot(null);
    setViewMode("detail");
  }, [inspector]);

  const { runningList, completedList } = useMemo(() => {
    const running: SubagentCollaboration[] = liveSubagents
      .filter((s) => s.status === "running")
      .map((s) => ({
        task_id: s.task_id,
        agent_id: s.agent_id,
        agent_name: s.agent_name,
        task: s.task,
        status: "running" as const,
        current_tool: s.current_tool,
        tool_preview: s.tool_preview,
        tools: s.tools || (s.current_tool ? [{ name: s.current_tool, output_preview: s.tool_preview }] : []),
        started_at: s.started_at,
        completed_at: s.completed_at,
        phase_name: s.phase_name,
        tokens_per_second: s.tokens_per_second,
        token_count: s.token_count,
      }));

    const completed: SubagentCollaboration[] = [];
    const seenIds = new Set<string>();

    const rawCollabs = inspector?.result_data?.collaborations || [];
    for (const c of rawCollabs) {
      const key = c.task_id || `${c.agent_id}-${c.task}`;
      seenIds.add(key);
      if (c.status === "running") {
        if (!running.some((r) => (r.task_id && r.task_id === c.task_id) || (r.agent_id === c.agent_id && r.task === c.task))) {
          running.push(c);
        }
      } else {
        completed.push(c);
      }
    }

    const contributions = inspector?.result_data?.contributions || [];
    for (const c of contributions) {
      const key = `${c.agent_id}-${c.text?.slice(0, 30)}`;
      if (!seenIds.has(key)) {
        seenIds.add(key);
        completed.push({
          agent_id: c.agent_id,
          agent_name: c.agent_name,
          task: "协同任务",
          status: "completed",
          result: c.text,
        });
      }
    }

    const dispatches = (inspector?.result_data?.tool_executions || []).filter(
      (item) => item.name === "dispatch_task",
    );
    for (const d of dispatches) {
      const view = dispatchView(d.output);
      const task = (d.arguments?.task as string) || "子任务";
      const key = `${d.arguments?.agent || view.agent}-${task}`;
      if (!seenIds.has(key)) {
        seenIds.add(key);
        const isErr = Boolean(
          (d.output as any)?.error || (d.output as any)?.result?.error,
        );
        completed.push({
          agent_id: (d.arguments?.agent as string) || view.agent,
          agent_name: view.agent,
          task,
          status: isErr ? "failed" : "completed",
          result: isErr ? undefined : view.text,
          error: isErr ? view.text : undefined,
        });
      }
    }

    for (const s of liveSubagents) {
      if (s.status === "completed" || s.status === "error") {
        const key = s.task_id || `${s.agent_id}-${s.task}`;
        if (!seenIds.has(key)) {
          seenIds.add(key);
          completed.push({
            task_id: s.task_id,
            agent_id: s.agent_id,
            agent_name: s.agent_name,
            task: s.task,
            status: s.status === "completed" ? "completed" : "failed",
            result: s.result,
            error: s.error,
            tools: s.tools,
            latency_ms: s.latency_ms,
            started_at: s.started_at,
            completed_at: s.completed_at,
            phase_name: s.phase_name,
            tokens_per_second: s.tokens_per_second,
            token_count: s.token_count,
          });
        }
      }
    }

    return { runningList: running, completedList: completed };
  }, [inspector, liveSubagents]);

  const onSelectCollab = (item: SubagentCollaboration) => {
    const key = item.task_id || `${item.agent_id}-${item.task}`;
    setSelectedKey(key);
    setSelectedCollabSnapshot(item);
    setViewMode("detail");
  };

  const activeCollab = useMemo(() => {
    if (!selectedKey) return null;
    const foundRunning = runningList.find(
      (r) => (r.task_id && r.task_id === selectedKey) || `${r.agent_id}-${r.task}` === selectedKey,
    );
    if (foundRunning) return foundRunning;
    const foundCompleted = completedList.find(
      (c) => (c.task_id && c.task_id === selectedKey) || `${c.agent_id}-${c.task}` === selectedKey,
    );
    if (foundCompleted) return foundCompleted;
    return selectedCollabSnapshot;
  }, [selectedKey, runningList, completedList, selectedCollabSnapshot]);

  const handleCopy = (text: string) => {
    navigator.clipboard.writeText(text);
    setCopied(true);
    setTimeout(() => setCopied(false), 2000);
  };

  const totalCount = runningList.length + completedList.length;

  if (activeCollab) {
    if (viewMode === "conversation") {
      return (
        <SubagentConversationView
          collab={activeCollab}
          onBack={() => setViewMode("detail")}
          toolNames={toolNames}
        />
      );
    }

    const durationMs = activeCollab.latency_ms ||
      (activeCollab.elapsed_seconds ? activeCollab.elapsed_seconds * 1000 : 0);
    const durationText = durationMs > 0
      ? formatRunDuration(durationMs)
      : activeCollab.status === "running"
        ? (activeCollab.started_at
            ? formatRunDuration(Date.now() - (activeCollab.started_at < 1e11 ? activeCollab.started_at * 1000 : activeCollab.started_at))
            : "协同执行中")
        : "完成";

    const isRunning = activeCollab.status === "running";

    return (
      <div className="collab-detail-pane">
        <div className="collab-detail-nav">
          <button
            type="button"
            className="collab-detail-back-btn"
            onClick={() => {
              setSelectedKey(null);
              setSelectedCollabSnapshot(null);
            }}
            title="返回子智能体列表"
            aria-label="返回子智能体列表"
          >
            <ArrowLeft size={14} />
            <span>返回子智能体列表</span>
          </button>
          <span className="collab-detail-nav-duration">用时 {durationText}</span>
        </div>

        <div className="collab-detail-container">
          {isRunning ? (
            <div className="collab-live-card">
              <div className="collab-live-header">
                <div className="collab-live-avatar">
                  <Bot size={15} />
                </div>
                <div className="collab-live-meta">
                  <strong>{activeCollab.agent_name}</strong>
                  <code>{activeCollab.agent_id}</code>
                </div>
                <span className="status-pill running">
                  <span className="pill-dot running" />
                  协同执行中
                </span>
              </div>

              {activeCollab.current_tool && (
                <div className="collab-live-tool">
                  <Sparkles size={12} className="spin-slow" />
                  <span>
                    正在调用工具：
                    <strong>
                      {toolNames?.[activeCollab.current_tool] || activeCollab.current_tool}
                    </strong>
                  </span>
                  {activeCollab.tool_preview && (
                    <pre className="collab-live-tool-preview">
                      {activeCollab.tool_preview}
                    </pre>
                  )}
                </div>
              )}

              {activeCollab.tools && activeCollab.tools.length > 0 && !activeCollab.current_tool && (
                <div className="collab-tools-list">
                  {activeCollab.tools.map((tool, idx) => (
                    <div className="collab-tool-item" key={idx}>
                      <div className="collab-tool-head">
                        <span className="tool-chip">
                          {toolNames[tool.name] || tool.name}
                        </span>
                        <code>{tool.name}</code>
                      </div>
                      {tool.arguments && Object.keys(tool.arguments).length > 0 && (
                        <pre className="collab-tool-args">
                          {JSON.stringify(tool.arguments, null, 2)}
                        </pre>
                      )}
                      {tool.output_preview && (
                        <div className="collab-tool-preview">
                          <span>输出摘要：</span>
                          <p>{tool.output_preview}</p>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}

              <div className="collab-live-task">
                <span className="collab-live-task-label">下发指令：</span>
                <p>{activeCollab.task}</p>
              </div>

              <div className="subagent-running-state">
                <span className="pulse" />
                <span>子智能体正在协同执行中，回传后将在此实时展示...</span>
              </div>

              <button
                type="button"
                className="collab-chat-action-btn live"
                onClick={() => setViewMode("conversation")}
              >
                <span style={{ display: "inline-flex", alignItems: "center", gap: 5 }}>
                  <MessageSquare size={12} />
                  进入实时对话 (只读)
                </span>
                <ChevronRight size={13} />
              </button>
            </div>
          ) : (
            <div className="collab-agent-card open">
              <header className="collab-card-header static">
                <div className="collab-agent-meta">
                  <div className="collab-bot-avatar">
                    <Bot size={15} />
                  </div>
                  <div className="collab-name-box">
                    <strong>{activeCollab.agent_name}</strong>
                    <code>{activeCollab.agent_id}</code>
                  </div>
                </div>
                <div className="collab-card-badges">
                  <span className={`status-pill ${activeCollab.status}`}>
                    <span className={`pill-dot ${activeCollab.status}`} />
                    {activeCollab.status === "completed" ? "已完成" : "执行失败"}
                  </span>
                  {activeCollab.phase_name && (
                    <span className="collab-phase-badge">{activeCollab.phase_name}</span>
                  )}
                  {activeCollab.tokens_per_second != null && (
                    <span className="collab-speed-badge">
                      {activeCollab.tokens_per_second} tok/s{activeCollab.tokens_per_second_approximate ? " (约)" : ""}
                    </span>
                  )}
                  {activeCollab.latency_ms != null && (
                    <span className="collab-latency">
                      {formatMs(activeCollab.latency_ms)}
                    </span>
                  )}
                  {activeCollab.tools && activeCollab.tools.length > 0 && (
                    <span className="collab-tools-badge">
                      <Sparkles size={11} />
                      {activeCollab.tools.length} 工具
                    </span>
                  )}
                </div>
              </header>

              <div className="collab-card-body">
                {(activeCollab.phase_name || activeCollab.tokens_per_second != null || activeCollab.token_count != null || activeCollab.elapsed_seconds != null) && (
                  <div className="collab-progress-metrics">
                    {activeCollab.phase_name && (
                      <div className="collab-metric-item">
                        <span className="collab-metric-label">阶段：</span>
                        <span className="collab-metric-val">{activeCollab.phase_name}</span>
                      </div>
                    )}
                    {activeCollab.token_count != null && (
                      <div className="collab-metric-item">
                        <span className="collab-metric-label">Token：</span>
                        <span className="collab-metric-val">
                          {activeCollab.token_count}{activeCollab.tokens_per_second_approximate ? " (约)" : ""}
                        </span>
                      </div>
                    )}
                    {activeCollab.tokens_per_second != null && (
                      <div className="collab-metric-item">
                        <span className="collab-metric-label">生成速度：</span>
                        <span className="collab-metric-val">
                          {activeCollab.tokens_per_second} tok/s
                        </span>
                      </div>
                    )}
                    {activeCollab.elapsed_seconds != null && (
                      <div className="collab-metric-item">
                        <span className="collab-metric-label">耗时：</span>
                        <span className="collab-metric-val">{activeCollab.elapsed_seconds}s</span>
                      </div>
                    )}
                  </div>
                )}

                <div className="collab-section">
                  <div className="collab-section-title">
                    <span>下发指令</span>
                  </div>
                  <div className="collab-task-box">{activeCollab.task}</div>
                </div>

                {activeCollab.tools && activeCollab.tools.length > 0 && (
                  <div className="collab-section">
                    <div className="collab-section-title">
                      <span>工具调用记录</span>
                      <span className="collab-count-pill">{activeCollab.tools.length}</span>
                    </div>
                    <div className="collab-tools-list">
                      {activeCollab.tools.map((tool, tIdx) => (
                        <div className="collab-tool-item" key={tIdx}>
                          <div className="collab-tool-head">
                            <span className="tool-chip">
                              {toolNames[tool.name] || tool.name}
                            </span>
                            <code>{tool.name}</code>
                          </div>
                          {tool.arguments && Object.keys(tool.arguments).length > 0 && (
                            <pre className="collab-tool-args">
                              {JSON.stringify(tool.arguments, null, 2)}
                            </pre>
                          )}
                          {tool.output_preview && (
                            <div className="collab-tool-preview">
                              <span>输出摘要：</span>
                              <p>{tool.output_preview}</p>
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <div className="collab-section">
                  <div className="collab-section-title">
                    <span>协同成果</span>
                    {activeCollab.result && (
                      <button
                        type="button"
                        className="subagent-copy-btn"
                        onClick={() => handleCopy(activeCollab.result!)}
                        title="复制回传成果"
                      >
                        {copied ? <Check size={12} /> : <Copy size={12} />}
                        <span>{copied ? "已复制" : "复制"}</span>
                      </button>
                    )}
                  </div>
                  {activeCollab.result ? (
                    <div className="collab-result-box">
                      <MarkdownText text={activeCollab.result} />
                    </div>
                  ) : activeCollab.error ? (
                    <div className="collab-error-box">
                      <p>{activeCollab.error}</p>
                    </div>
                  ) : (
                    <div className="inspector-empty">未产生回答内容</div>
                  )}
                </div>

                <button
                  type="button"
                  className="collab-chat-action-btn live"
                  onClick={() => setViewMode("conversation")}
                >
                  <span style={{ display: "inline-flex", alignItems: "center", gap: 5 }}>
                    <MessageSquare size={12} />
                    进入实时对话 (只读)
                  </span>
                  <ChevronRight size={13} />
                </button>
              </div>
            </div>
          )}
        </div>
      </div>
    );
  }

  if (totalCount === 0) {
    return (
      <div className="collab-empty">
        <Bot size={28} className="empty-icon" />
        <p>本次任务暂无子智能体协同记录</p>
        <span>当协调型智能体派发子任务时，将在此展示协同详情与成果回传</span>
      </div>
    );
  }

  return (
    <div className="collab-concise-panel">
      <div className="collab-overview-bar">
        <span>协同智能体 ({totalCount})</span>
        <span className="collab-mode-tag">
          {inspector?.result_data?.mode === "coordination"
            ? "总监协调调度"
            : "多智能体协同"}
        </span>
      </div>

      <div className="collab-concise-section">
        <div className="collab-concise-heading">
          <span>已开启 · {runningList.length}</span>
        </div>
        {runningList.length === 0 ? (
          <div className="collab-concise-empty">没有已开启的子代理</div>
        ) : (
          <div className="collab-concise-list">
            {runningList.map((item, idx) => {
              const palette = getSubagentPalette(idx, item.agent_id || item.agent_name);
              const Icon = palette.icon;
              const toolLabel = item.current_tool
                ? (toolNames[item.current_tool] || item.current_tool)
                : item.tools?.length
                  ? (toolNames[item.tools[item.tools.length - 1].name] || item.tools[item.tools.length - 1].name)
                  : null;
              return (
                <button
                  type="button"
                  key={item.task_id || `${item.agent_id}-${idx}`}
                  className="collab-concise-item running"
                  onClick={() => onSelectCollab(item)}
                >
                  <div
                    className="collab-concise-icon"
                    style={{ color: palette.color, backgroundColor: palette.bg }}
                  >
                    <Icon size={16} />
                  </div>
                  <div className="collab-concise-meta">
                    <span className="collab-concise-title">{item.agent_name || item.task}</span>
                  </div>
                  <div className="collab-concise-right">
                    <span className="collab-live-tag">
                      <span className="pulse" />
                      {toolLabel ? `调用${toolLabel}` : "进行中"}
                    </span>
                  </div>
                </button>
              );
            })}
          </div>
        )}
      </div>

      <div className="collab-concise-section">
        <div className="collab-concise-heading">
          <span>完成 · {completedList.length}</span>
        </div>
        {completedList.length === 0 ? (
          <div className="collab-concise-empty">暂无已完成的子代理</div>
        ) : (
          <div className="collab-concise-list">
            {completedList.map((item, idx) => {
              const palette = getSubagentPalette(idx + runningList.length, item.agent_id || item.agent_name);
              const Icon = palette.icon;
              const timeText = formatSubagentTime(
                item.started_at,
                item.completed_at,
                item.latency_ms || (item.elapsed_seconds ? item.elapsed_seconds * 1000 : undefined),
              );
              return (
                <button
                  type="button"
                  key={item.task_id || `${item.agent_id}-${idx}`}
                  className="collab-concise-item"
                  onClick={() => onSelectCollab(item)}
                >
                  <div
                    className="collab-concise-icon"
                    style={{ color: palette.color, backgroundColor: palette.bg }}
                  >
                    <Icon size={16} />
                  </div>
                  <div className="collab-concise-meta">
                    <span className="collab-concise-title">{item.agent_name || item.task}</span>
                  </div>
                  <div className="collab-concise-right">
                    {item.status === "failed" ? (
                      <span className="status-pill failed" style={{ fontSize: 10, padding: "1px 6px" }}>
                        <span className="pill-dot failed" />
                        失败
                      </span>
                    ) : (
                      <span className="collab-concise-time">{timeText}</span>
                    )}
                  </div>
                </button>
              );
            })}
          </div>
        )}
      </div>
    </div>
  );
}

