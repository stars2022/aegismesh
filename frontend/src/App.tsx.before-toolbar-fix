function formatMs(value: number) {
  return value >= 1000
    ? `${(value / 1000).toFixed(1)} s`
    : `${Math.round(value)} ms`;
}

function App({ onLogout }: { onLogout?: () => void }) {
  const [view, setView] = useState<View>("overview");
  const [mobileNav, setMobileNav] = useState(false);
  const [sidebarCollapsed, setSidebarCollapsed] = useState(false);
  const [dashboard, setDashboard] = useState<DashboardData | null>(null);
  const [agents, setAgents] = useState<Agent[]>([]);
  const [providers, setProviders] = useState<Provider[]>([]);
  const [policy, setPolicy] = useState<Policy | null>(null);
  const [traces, setTraces] = useState<Trace[]>([]);
  const [probes, setProbes] = useState<ProbeResult[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState("");

  const load = async () => {
    setLoading(true);
    try {
      const [
        nextDashboard,
        nextAgents,
        nextProviders,
        nextPolicy,
        nextTraces,
        nextProbes,
      ] = await Promise.all([
        api.dashboard(),
        api.agents(),
        api.providers(),
        api.policy(),
        api.traces(),
        api.probes(),
      ]);
      setDashboard(nextDashboard);
      setAgents(nextAgents);
      setProviders(nextProviders);
      setPolicy(nextPolicy);
      setTraces(nextTraces);
      setProbes(nextProbes);
      setError("");
    } catch (reason) {
      setError(reason instanceof Error ? reason.message : "连接失败");
    } finally {
      setLoading(false);
    }
  };

  useEffect(() => {
    void load();
  }, []);

  return (
    <div className={`app-shell ${sidebarCollapsed ? "sidebar-collapsed" : ""}`}>
      <aside className={`sidebar ${mobileNav ? "open" : ""}`}>
        <div className="brand">
          <div className="brand-mark">
            <Network size={18} />
          </div>
          <div>
            <strong>AegisMesh</strong>
          </div>
        </div>
        <button
          className="sidebar-collapse"
          onClick={() => setSidebarCollapsed((value) => !value)}
          title={sidebarCollapsed ? "展开侧栏" : "折叠侧栏"}
        >
          {sidebarCollapsed ? (
            <PanelLeftOpen size={16} />
          ) : (
            <PanelLeftClose size={16} />
          )}
        </button>
        <button
          className="new-agent-button"
          onClick={() => {
            setView("studio");
            setMobileNav(false);
          }}
        >
          <CirclePlus size={17} /> 新建智能体 <span>⌘ N</span>
        </button>
        <nav>
          <div className="nav-label">工作区</div>
          {navigation.map((item) => {
            const Icon = item.icon;
            return (
              <button
                key={item.id}
                className={view === item.id ? "active" : ""}
                onClick={() => {
                  setView(item.id);
                  setMobileNav(false);
                }}
              >
                <Icon size={17} />
                {item.label}
                {item.id === "traces" && traces.length > 0 && (
                  <b>{traces.length}</b>
                )}
              </button>
            );
          })}
        </nav>
        <div className="sidebar-spacer" />
        <div className="system-card">
          <div>
            <StatusDot status={error ? "offline" : "online"} />
            {error ? "API 未连接" : "系统运行中"}
          </div>
          <span>
            {agents.filter((agent) => agent.health === "online").length}{" "}
            个智能体在线
          </span>
        </div>
        <div className="profile-row">
          <div className="avatar">AM</div>
          <div>
            <strong>工作区</strong>
            <span>管理空间</span>
          </div>
          {onLogout ? (
            <button onClick={onLogout} title="退出登录">
              <LogOut size={15} />
            </button>
          ) : (
            <Settings2 size={16} />
          )}
        </div>
      </aside>
      {mobileNav && (
        <button className="nav-backdrop" onClick={() => setMobileNav(false)} />
      )}

      <main className="main-panel">
        <header className="topbar">
          <button className="mobile-menu" onClick={() => setMobileNav(true)}>
            <Menu size={20} />
          </button>
          <div>
            <h1>{titles[view]}</h1>
          </div>
          <div className="topbar-actions">
            <button
              className="icon-button"
              onClick={() => void load()}
              title="刷新"
            >
              <RefreshCw size={17} className={loading ? "spin" : ""} />
            </button>
            <a className="primary-small" href="/">
              <Play size={15} fill="currentColor" />
              打开聊天
            </a>
          </div>
        </header>
        {error && (
          <div className="connection-banner">
            <span>{error}</span>
            <button onClick={() => void load()}>重新连接</button>
          </div>
        )}
        <div className="page-content">
          {view === "overview" && (
            <Overview
              dashboard={dashboard}
              agents={agents}
              traces={traces}
              loading={loading}
            />
          )}
          {view === "studio" && (
            <Studio agents={agents} providers={providers} onChanged={load} />
          )}
          {view === "providers" && (
            <Providers providers={providers} agents={agents} onChanged={load} />
          )}
          {view === "routing" && policy && (
            <Routing policy={policy} agents={agents} onSaved={load} />
          )}
          {view === "probes" && (
            <Probes agents={agents} probes={probes} onRun={load} />
          )}
          {view === "traces" && <Traces traces={traces} />}
          {view === "access" && <AccessControl />}
        </div>
      </main>
    </div>
  );
}

