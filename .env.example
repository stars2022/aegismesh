# Runtime
DATABASE_URL=sqlite:///./backend/data/aegismesh.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_API_KEY=

# Management console authentication is fail-closed. Run scripts/setup-admin.sh before use.
ADMIN_AUTH_ENABLED=true
ADMIN_SESSION_SECRET=
ADMIN_SESSION_HOURS=12
ADMIN_COOKIE_SECURE=false
PROVIDER_ENCRYPTION_KEY=
# JSON map of approved environment-secret names to their exact HTTPS origins.
PROVIDER_SECRET_ENV_BINDINGS={}

# Required by scripts/deploy.sh for public deployment
TLS_CERT_FILE=
TLS_KEY_FILE=

# Optional OpenAI-compatible model (DeepSeek / Qwen / Doubao / others)
LLM_API_BASE=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_ENABLED=false

# OpenAI Responses API
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Anthropic Messages API
ANTHROPIC_API_BASE=https://api.anthropic.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
DEEPSEEK_SEARCH_MODEL=deepseek-v4-flash
WEB_SEARCH_MAX_RESULTS=8
WEB_SEARCH_TIMEOUT_SECONDS=60

# AIP identity issued through trusted registration
LEADER_AIC=
AIP_POLL_INTERVAL_SECONDS=0.8
AIP_IDENTITY_BINDING_ENABLED=false
AIP_CA_FILE=
AIP_CERT_FILE=
AIP_KEY_FILE=
AIP_TLS_CERTFILE=
AIP_TLS_KEYFILE=
AIP_TLS_CLIENT_CA_FILE=
AIP_TLS_PORT=0
# External AIP task total budget, inherited by recursive calls (1–1800 seconds).
AIP_TASK_TIMEOUT_SECONDS=600
# 不同 AIC 使用独立主机或端口；变更已审核 ACS 须由平台允许，不能重注册绕过。
# 示例：{"research_leader":"https://aip.example.com:8443","docs_overview":"https://aip.example.com:8444"}
AIP_AGENT_PUBLIC_URLS={}
# 每个 mTLS 服务实例绑定一个 agent ID；证书取 CERTS_DIR/<AIC>.serverauth.{pem,key}。
AIP_TLS_AGENT_ID=
# Primary API owns background tasks; dedicated TLS listeners set this to false.
BACKGROUND_WORKER_ENABLED=true
AIP_NOTIFICATION_ALLOWED_ORIGINS=

# Public URL used in the ACS submitted to the trusted registry
PUBLIC_BASE_URL=

# Trusted registry and certificate authority
REGISTRY_API_URL=https://wt.ioa.pub/registry-server/api/v1
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
REGISTRY_TIMEOUT_SECONDS=15
CA_SERVER_URL=
CA_ACCOUNT_KEY_FILE=
CERTS_DIR=data/certs

# ADP discovery server, for example https://discovery.example.com
ADP_DISCOVERY_URL=
ADP_TIMEOUT_SECONDS=10
PROBE_INTERVAL_SECONDS=30

# 本地日志索引：只读 AMP 文件，不影响 Fluent Bit 上报和游标。
AMP_LOG_DIR=logs
LOG_INDEXER_ENABLED=true
LOG_INDEX_INTERVAL_SECONDS=5
LOG_RETENTION_DAYS=7
LOG_MAX_RECORDS=100000
AUDIT_RETENTION_DAYS=90
AUDIT_MAX_RECORDS=50000
# 多进程仅让 API 单 worker 建索引；scripts.serve 的 mTLS worker 自动禁用索引器。

# ---- AIP 国标群组模式（可选；不配置时集群研讨走本地黑板）----
# RabbitMQ 连接（二选一）
AIP_GROUP_MQ_URL=
# 官方接入（先验证证书与信任包，再启用）：amqps://wt.ioa.pub:5671/acps
# AIP_GROUP_MQ_HOST=wt.ioa.pub
# AIP_GROUP_MQ_PORT=5671
# AIP_GROUP_MQ_VHOST=acps
# 仅使用每个 AIC 的 clientAuth 证书 + EXTERNAL，不使用 guest 账号。
AIP_GROUP_AUTH_URL=
# 官方已验证入口：https://wt.ioa.pub:9007
AIP_GROUP_DISCUSSION_TIMEOUT_SECONDS=120
# 让本平台智能体作为 Partner 接受外部群组邀请（需 MQ 配置）
AIP_GROUP_PARTNER_ENABLED=false
AIP_GROUP_PARTNER_AGENT_ID=
# 留空则监听全部已审核托管智能体；仅 API 单进程拥有监听，mTLS 进程禁用。
AIP_GROUP_LISTENER_WORKER=true
